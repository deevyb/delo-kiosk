# Supabase Configuration (Required)
# Get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Admin Panel (Required)
# Choose your own passcode for accessing /admin
ADMIN_PASSCODE=your-admin-passcode

# Tap to Pay with Venmo (optional — leave empty for free events / to hide the feature)
# To enable: handle without the @, and the flat per-drink event price, e.g. 6.00
NEXT_PUBLIC_VENMO_HANDLE=
NEXT_PUBLIC_VENMO_PRICE=
