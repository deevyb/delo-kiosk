# Supabase Configuration (Required)
# Get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Admin Panel (Required)
# Choose your own passcode for accessing /admin
ADMIN_PASSCODE=your-admin-passcode

# Tap to Pay with Venmo (optional — leave unset for free events / to hide the feature)
# Handle without the @; price is the flat per-drink event price, e.g. 6.00
NEXT_PUBLIC_VENMO_HANDLE=your-venmo-handle
NEXT_PUBLIC_VENMO_PRICE=6.00
